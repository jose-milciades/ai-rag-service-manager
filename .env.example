# Referencia de variables reconocidas por app/core/config.py (Settings).
#
# Precedencia real (ver get_settings(), pendientes.md P-17):
# 1. USE_VAULT_CONFIG=true -> se intenta Vault (mismo patron explicito que
#    USE_SPRING_CLOUD_CONFIG/EUREKA_ENABLED, no se infiere nada por presencia
#    de otras variables). Si faltan VAULT_ADDR/VAULT_TOKEN, falla fuerte con
#    un mensaje claro listando lo que falta.
# 2. USE_VAULT_CONFIG en false o ausente (default) -> no se intenta Vault: la
#    config sale de variables ya exportadas al proceso y, como fallback, de
#    este archivo copiado a `.env` en la raiz del repo (Settings.model_config
#    trae env_file=".env"). Las variables exportadas por el shell siguen
#    ganando sobre lo que haya en `.env`.
#
# Para trabajo 100% local sin Vault/Spring/Eureka (default de este archivo):
# copia este archivo a `.env` y no toques nada de esta seccion.

# ---- Vault ----
USE_VAULT_CONFIG=false
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=root-token
# VAULT_CACERT=/ruta/al/ca.pem
# VAULT_SKIP_VERIFY=false

# ---- Aplicacion ----
DEBUG=false
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
# Lista separada por comas. "*" (default) sirve CORS abierto sin credenciales.
# Con origenes explicitos, el servicio habilita allow_credentials=True.
CORS_ALLOWED_ORIGINS=*
# Lista separada por comas de integraciones que, si estan habilitadas
# (USE_SPRING_CLOUD_CONFIG / EUREKA_ENABLED) y fallan, deben tumbar
# GET /api/v1/health/ready con 503. Si una integracion nunca se habilito
# (variables ausentes), nunca cuenta como fallo, sin importar esta lista.
READINESS_CRITICAL_DEPENDENCIES=config_server,eureka

# ---- Spring Cloud Config (solo se consulta durante el startup) ----
USE_SPRING_CLOUD_CONFIG=false
SPRING_CLOUD_CONFIG_URI=http://localhost:8888
SPRING_PROFILES_ACTIVE=default
# En un ambiente compartido con Config Server real, algo asi:
# USE_SPRING_CLOUD_CONFIG=true
# SPRING_CLOUD_CONFIG_URI=http://config-server:8888

# ---- Eureka ----
EUREKA_ENABLED=false
# eureka_server_url acepta, en orden: EUREKA_SERVER_URL, EUREKA_SERVER, o la
# convencion Spring Boot EUREKA_CLIENT_SERVICEURL_DEFAULTZONE (util si este
# servicio comparte ambiente/company-secrets con microservicios Java que ya
# usan ese nombre). Definir una sola de las tres.
EUREKA_SERVER_URL=http://localhost:8761/eureka/
# EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/
EUREKA_APP_NAME=ai-rag-service-manager
EUREKA_INSTANCE_HOST=ai-rag-service-manager
EUREKA_INSTANCE_IP=127.0.0.1
EUREKA_REGISTER_MAX_RETRIES=3
EUREKA_REGISTER_RETRY_DELAY=2
# En un ambiente compartido con Eureka real, algo asi:
# EUREKA_ENABLED=true

# ---- Storage / Google Cloud Storage ----
# GOOGLE_CREDS_JSON debe contener el JSON completo de la service account en
# una sola linea. No dejes un valor real en este archivo de ejemplo.
GOOGLE_CREDS_JSON=
STORAGE_PROJECT_ID=
STORAGE_DEFAULT_BUCKET_NAME=
STORAGE_PUBLIC_BUCKET_NAME=
STORAGE_CHUNK_UPLOAD_TEMP_DIR=.runtime/uploads

# ---- Vector DB ----
# "memory" (default) usa InMemoryVectorStore (se pierde al reiniciar).
# "milvus" usa MilvusVectorStore contra un Milvus real (MILVUS_HOST/PORT).
# MILVUS_USER/MILVUS_PASSWORD solo se envian si ambos vienen definidos (un
# Milvus sin auth, como el de desarrollo local tipico, no los necesita).
# MILVUS_ALIAS no lo usa MilvusVectorStore (usa pymilvus.MilvusClient, que no
# tiene concepto de alias de conexion global); se deja documentado por si se
# vuelve a necesitar con la API de conexiones clasica de pymilvus.
VECTOR_DB_TYPE=memory
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_ALIAS=default
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_INDEX_NLIST=128
MILVUS_SEARCH_NPROBE=10

# ---- RAG ----
# RAG_EMBEDDING_PROVIDER: unico valor soportado "openai" (decision de
# negocio, ver pendientes.md P-19 -- el backend local via
# sentence-transformers/torch que existia antes fue removido del todo para
# bajar el tamano de la imagen Docker). RAG_EMBEDDING_MODEL es un modelo de
# embeddings de OpenAI (ej. text-embedding-3-large, el mismo que ya usa en
# produccion edi-ai-analysis-ai). Requiere OPENAI_API_KEY.
# RAG_ENVIRONMENT: ambiente logico (equivalente Milvus al "index" de
# Pinecone en edi-ai-analysis-ai, ver pendientes.md P-33). Se usa como
# nombre de PARTICION Milvus dentro de la coleccion de cada proyecto
# (coleccion = proyecto solo, ej. "project_127"; particion = este valor,
# ej. "edi_dev"). Valores permitidos: edi-local | edi-dev | edi-stage | edi-prod.
RAG_ENVIRONMENT=edi-local
RAG_DEFAULT_COLLECTION_NAME=default_rag_collection
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_API_KEY: requerido si RAG_EMBEDDING_PROVIDER=openai. No reutilizar
# una key ya expuesta/commiteada en ningun lado -- generar una nueva en
# https://platform.openai.com/api-keys.
OPENAI_API_KEY=
# RAG_OPENAI_EMBEDDING_DIMENSIONS: opcional, solo para modelos v3
# (text-embedding-3-large/small) -- trunca el vector via el parametro
# `dimensions` de la API para reducir costo/almacenamiento. Comentada = usa
# la dimension nativa del modelo (3072 para text-embedding-3-large). Debe
# quedar sin definir o con un entero valido -- un string vacio no parsea.
# RAG_OPENAI_EMBEDDING_DIMENSIONS=256
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_LIST_LIMIT=100
RAG_MAX_EMBEDDINGS_PER_DOCUMENT=1000
RAG_UNIQUE_CODE_LIST_LIMIT=10000
